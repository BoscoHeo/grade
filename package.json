{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:frontend": "vite build --configLoader runner",
    "build:backend": "node scripts/build-backend.mjs",
    "build": "npm run build:frontend && npm run build:backend && npm run check:artifacts",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "test:artifacts": "node --test scripts/check-artifacts.test.mjs",
    "start": "node dist/backend/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:ai-routing": "node --test scripts/ai-routing.test.mjs",
    "test:credentials": "node --test scripts/credential-storage.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
